<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Designer luôn chạy ở 100 % để toạ độ trong *.Designer.cs là px 96 DPI -->
    <ForceDesignerDPIUnaware>true</ForceDesignerDPIUnaware>
    <!--
      Bản KÉO THẢ: mọi màn hình có *.Designer.cs (InitializeComponent) mở được trong Windows Forms Designer.
      DPI: PerMonitorV2 + AutoScaleMode.Dpi chuẩn của WinForms (form / trang tự nhân bố cục designer theo DPI màn, kể cả khi kéo sang màn khác).
      AppTheme.K chỉ còn dùng cho phần VẼ TAY (biểu đồ, thẻ tác giả, hoạ tiết thẻ) và tính toán bố cục lúc chạy; MainForm tắt AutoHandDpi của AntdUI.
      Chụp ảnh kiểm tra: QLTG_SHOT=<thư mục> QuanLyTacGiaDesign.exe (xem Ui/ScreenshotHarness.cs).
    -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>QuanLyTacGia</RootNamespace>
    <AssemblyName>QuanLyTacGiaDesign</AssemblyName>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AntdUI" Version="2.4.8" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
